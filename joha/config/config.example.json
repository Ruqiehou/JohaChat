{
  "llm": {
    "active_provider": "deepseek",
    "providers": [
      {
        "name": "alibaba",
        "label": "阿里云（通义千问）",
        "role": "chat",
        "api_key": "YOUR_API_KEY_HERE",
        "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "model": "qwen3.5-omni-flash-2026-03-15",
        "default": false
      }
    ]
  },
  "tool_calling": {
    "enabled": true,
    "description": "工具调用开关：启用后主回复流程可按需调用 joha/tools 下自动发现的工具"
  },
  "admin": {
    "admins": [
      "YOUR_ADMIN_QQ_NUMBER_1",
      "YOUR_ADMIN_QQ_NUMBER_2"
    ]
  },
  "message_queue": {
    "enabled": true,
    "merge_window": 120.0,
    "max_queue_size": 5,
    "min_messages_to_merge": 2,
    "description": "消息队列配置：合并短时间内的多条消息，减少废话回复。min_messages_to_merge=2表示至少2条消息才会因超时而处理"
  }
}
